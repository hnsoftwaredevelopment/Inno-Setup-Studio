<Window x:Class="Studio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App" xmlns:views="clr-namespace:Studio.App.Views" xmlns:core="clr-namespace:Studio.Core;assembly=Studio.Core"
        Title="Inno Setup Studio" Icon="Resources/AppIcon.ico" Width="1360" Height="860" MinWidth="950" MinHeight="520" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="OutputNameSettings">
            <StackPanel>
                <Label Content="{loc:Loc OutputNameLabel}" Target="{Binding ElementName=OutputName}" Padding="0" Margin="0,0,0,6"/>
                <TextBox x:Name="OutputName" Text="{Binding OutputBaseFileName,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                         AutomationProperties.Name="{loc:Loc OutputNameLabel}"/>
                <TextBlock Text="{loc:Loc SetupNameWarning}" TextWrapping="Wrap" Foreground="#9B5700" Margin="0,6,0,0"
                           Visibility="{Binding HasSetupNameWarning,Converter={StaticResource Visibility}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
    </Window.CommandBindings>
    <Grid x:Name="Workspace">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="30" Height="30" Margin="0,0,12,0">
                        <Image Source="{StaticResource AppLogo}" Stretch="Uniform" AutomationProperties.Name="Inno Setup Studio" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inno Setup Studio" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc AppSubtitle}" FontSize="11" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="{loc:Loc LanguageLabel}" Target="{Binding ElementName=LanguagePicker}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguagePicker" Width="132" MinHeight="30"
                              ItemsSource="{x:Static core:StudioLocalizer.Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding Language, Source={x:Static loc:Localization.Current}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{loc:Loc LanguageLabel}" />
                </StackPanel>
            </DockPanel>
                <Menu Background="White" Margin="0,4,0,0">
                    <MenuItem Header="{loc:Loc ProjectMenu}">
                        <MenuItem Header="{loc:Loc New}" Command="ApplicationCommands.New" CommandTarget="{Binding ElementName=Workspace}"/>
                        <MenuItem Header="{loc:Loc Open}" Command="ApplicationCommands.Open" CommandTarget="{Binding ElementName=Workspace}"/>
                        <MenuItem Header="{loc:Loc Save}" Command="ApplicationCommands.Save" CommandTarget="{Binding ElementName=Workspace}"/>
                        <MenuItem Header="{loc:Loc SaveAs}" Command="ApplicationCommands.SaveAs" CommandTarget="{Binding ElementName=Workspace}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc ApplicationDetails}" Click="ApplicationDetails_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc ProjectLanguages}" Click="ProjectLanguages_Click" IsEnabled="{Binding IsDesign}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc InstallationMenu}">
                        <MenuItem Header="{loc:Loc InstallFileHeading}" Click="FileRules_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc DirectoryRulesHeading}" Click="DirectoryRules_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc ShortcutsHeading}" Click="Shortcuts_Click" IsEnabled="{Binding IsDesign}"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc InstallTypesHeading}" Click="InstallTypes_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc ComponentsHeading}" Click="Components_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc TasksHeading}" Click="Tasks_Click" IsEnabled="{Binding IsDesign}"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc BuildMenu}">
                        <MenuItem Header="{loc:Loc BuildInstaller}" Click="Build_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc ExportScript}" Click="Export_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem x:Name="OpenBuildFolder" Header="{loc:Loc OpenBuildFolder}" Click="OpenBuildFolder_Click" IsEnabled="False"/>
                        <MenuItem x:Name="BuildMessagesMenu" Header="{loc:Loc BuildMessages}" Click="BuildMessages_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc OutputNameLabel}" Click="OutputName_Click" IsEnabled="{Binding IsDesign}"/>
                        <MenuItem Header="{loc:Loc ChooseCompiler}" Click="ChooseCompiler_Click"/>
                        <MenuItem Header="{loc:Loc CheckCompiler}" Click="CheckCompiler_Click"/>
                        <MenuItem x:Name="CompilerStatus" IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                        <MenuItem Header="{loc:Loc LanguageSources}" Click="LanguageSources_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="222" MinWidth="180" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" MinWidth="400" /><ColumnDefinition Width="5" /><ColumnDefinition Width="292" MinWidth="240" /></Grid.ColumnDefinitions>
            <Border Background="White" Padding="12,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Pages}" Style="{StaticResource SectionLabel}" />
                            <Button Content="{loc:Loc WizardPageOverview}" Click="WizardPageOverview_Click" IsEnabled="{Binding IsDesign}" Margin="0,0,0,12"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PageChoices}" SelectedValuePath="Index" SelectedValue="{Binding PageIndex}" IsEnabled="{Binding IsDesign}" AutomationProperties.Name="{loc:Loc PagesAccessible}">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" Height="1" Background="{StaticResource Line}" Margin="0,12" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc Elements}" Style="{StaticResource SectionLabel}" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding Elements}" SelectedValuePath="Kind" SelectedValue="{Binding SelectedElement}" IsEnabled="{Binding IsDesign}" AutomationProperties.Name="{loc:Loc ElementsAccessible}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="{loc:Loc PagesWidth}" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="16,12,16,10">
                    <TextBlock Text="{Binding PageName}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="16,10">
                    <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Label Content="{loc:Loc PreviewLanguage}" Target="{Binding ElementName=PreviewLanguagePicker}"/>
                        <ComboBox x:Name="PreviewLanguagePicker" Width="180" ItemsSource="{Binding PreviewLanguages}"
                                  DisplayMemberPath="StatusName" SelectedValuePath="Id" SelectedValue="{Binding PreviewLanguageId, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc PreviewLanguage}"/>
                        <Button Content="{loc:Loc TranslationOverview}" Click="TranslationOverview_Click" IsEnabled="{Binding IsDesign}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding PreviewLanguageHint}" TextWrapping="Wrap" Margin="12,5,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding TranslationSummary}" TextWrapping="Wrap" Margin="0,0,0,8"
                               AutomationProperties.Name="{loc:Loc TranslationStatus}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#486452"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasMissingTranslations}" Value="True"><Setter Property="Foreground" Value="#9B5700"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Zoom}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <Slider Width="94" Minimum="0.5" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Zoom}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc Zoom}" />
                            <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{loc:Loc Design}" GroupName="Mode" IsChecked="{Binding IsDesign, Mode=OneWay}" Checked="Design_Checked" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <RadioButton Content="{loc:Loc TryOut}" GroupName="Mode" IsChecked="{Binding IsPreview, Mode=OneWay}" Checked="Preview_Checked" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E9EDF0" Padding="24">
                    <views:WizardPreview HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:WizardPreview.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /></views:WizardPreview.LayoutTransform>
                    </views:WizardPreview>
                </ScrollViewer>
                <Border Grid.Row="3" Background="#F6F7F8" Padding="24,12" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{loc:Loc PreviewDisclaimer}" Style="{StaticResource MutedText}" FontSize="11" />
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="{loc:Loc PropertiesWidth}" />
            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Properties}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding SelectedElementName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Origin}" Style="{StaticResource MutedText}" Margin="0,8,0,8" />
                        <TextBlock Text="{Binding PropertyScopeHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,20" />
                        <TextBlock Text="{Binding EditingLanguageName}" FontWeight="SemiBold" Margin="0,0,0,8"
                                   Visibility="{Binding ShowInheritance, Converter={StaticResource Visibility}}"/>
                        <Label Content="{Binding PropertyLabel}" Target="{Binding ElementName=PropertyTextBox}" Padding="0" Margin="0,0,0,8" />
                        <Grid ClipToBounds="True" MaxHeight="240">
                            <TextBox x:Name="PropertyTextBox" VerticalContentAlignment="Top" Text="{Binding PropertyText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" TextWrapping="Wrap" AcceptsReturn="{Binding AllowsMultiline}" MinHeight="84" MaxHeight="240" VerticalScrollBarVisibility="Auto" MaxLength="4096" AutomationProperties.Name="{loc:Loc ElementTextAccessible}" AutomationProperties.HelpText="{Binding EffectiveText}" />
                            <TextBlock Text="{Binding EffectiveText}" Foreground="#8A929A" TextWrapping="Wrap" Margin="12,10" IsHitTestVisible="False" Visibility="{Binding ShowTextWatermark, Converter={StaticResource Visibility}}" />
                        </Grid>
                        <Button Content="{loc:Loc UseEffectiveText}" Click="UseEffectiveText_Click" IsEnabled="{Binding CanEdit}" Visibility="{Binding ShowCopyText, Converter={StaticResource Visibility}}" Margin="0,8,0,0" />
                        <Button Content="{loc:Loc ResetTranslationText}" Click="Reset_Click" IsEnabled="{Binding CanReset}" Visibility="{Binding ShowResetText, Converter={StaticResource Visibility}}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedTranslationHint}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding SelectedTextMissing, Converter={StaticResource Visibility}}" />
                        <TextBlock Text="{Binding SelectedReferenceWarnings}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="{Binding HasSelectedReferenceWarnings, Converter={StaticResource Visibility}}" />
                        <Button Content="{loc:Loc ChooseFolder}" Click="ChooseDirectory_Click" IsEnabled="{Binding CanEdit}" Visibility="{Binding IsDirectorySelected, Converter={StaticResource Visibility}}" Margin="0,12,0,0" />
                        <StackPanel Visibility="{Binding IsBrowseSelected, Converter={StaticResource Visibility}}" Margin="0,16,0,0">
                            <Label Content="{loc:Loc TooltipLabel}" Target="{Binding ElementName=TooltipBox}" Padding="0" Margin="0,0,0,8" />
                            <Grid ClipToBounds="True" MaxHeight="160">
                                <TextBox x:Name="TooltipBox" VerticalContentAlignment="Top" Text="{Binding BrowseTooltip, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto" MaxLength="4096" TextWrapping="Wrap" AutomationProperties.Name="{loc:Loc BrowseTooltipAccessible}" AutomationProperties.HelpText="{Binding EffectiveBrowseTooltip}" />
                                <TextBlock Text="{Binding EffectiveBrowseTooltip}" Foreground="#8A929A" TextWrapping="Wrap" Margin="12,10" IsHitTestVisible="False" Visibility="{Binding ShowTooltipWatermark, Converter={StaticResource Visibility}}" />
                            </Grid>
                            <Button Content="{loc:Loc UseEffectiveText}" Click="UseEffectiveTooltip_Click" IsEnabled="{Binding CanCopyTooltip}" Visibility="{Binding ShowCopyTooltip, Converter={StaticResource Visibility}}" Margin="0,8,0,0" />
                            <Button Content="{loc:Loc ResetTranslationTooltip}" Click="ResetTooltip_Click" IsEnabled="{Binding CanResetTooltip}" Visibility="{Binding ShowResetTooltip, Converter={StaticResource Visibility}}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding BrowseTooltipOrigin}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding TooltipReferenceWarnings}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Visibility="{Binding HasTooltipReferenceWarnings, Converter={StaticResource Visibility}}" />
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,24" />
                        <Expander Header="{loc:Loc InheritanceHeading}" Visibility="{Binding ShowInheritance, Converter={StaticResource Visibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc TranslationInheritanceHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:Loc TranslationReferencesHint}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Border Background="#F2F5F6" Padding="12" Margin="0,24,0,0" CornerRadius="4">
                            <TextBlock Text="{loc:Loc TryOutHint}" Style="{StaticResource MutedText}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DocumentState}" Foreground="{StaticResource Muted}" FontSize="11" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
