<Window x:Class="Studio.App.DirectoryRulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{loc:Loc DirectoryRulesHeading}" Icon="Resources/AppIcon.ico" Width="900" Height="740" MinWidth="720" MinHeight="540" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Loc DirectoryRulesHeading}" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="{loc:Loc DirectoryRulesHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <Button Content="{loc:Loc FilesAdd}" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0"/>
    <Button Content="{loc:Loc FilesRemove}" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/>
   </WrapPanel>
   <ListBox ItemsSource="{Binding Rules}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc DirectoryRulesHeading}"/>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel IsEnabled="{Binding HasSelection}" Margin="0,0,10,0">
     <Label Content="{loc:Loc DirectoryTarget}" Target="{Binding ElementName=TargetInput}" Padding="0"/>
     <TextBox x:Name="TargetInput" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" Margin="0,6,0,6"/>
     <TextBlock x:Name="RuleError" Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,6"/>
     <TextBlock Text="{loc:Loc DirectoryTargetHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     <TextBlock Text="{loc:Loc DirectoryAttributesHeading}" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
     <UniformGrid Columns="2">
      <CheckBox Content="{loc:Loc DirectoryReadOnly}" IsChecked="{Binding ReadOnly}" Margin="0,0,12,8"/>
      <CheckBox Content="{loc:Loc DirectoryHidden}" IsChecked="{Binding Hidden}" Margin="0,0,0,8"/>
      <CheckBox Content="{loc:Loc DirectorySystem}" IsChecked="{Binding System}" Margin="0,0,12,8"/>
      <CheckBox Content="{loc:Loc DirectoryNotContentIndexed}" IsChecked="{Binding NotContentIndexed}" Margin="0,0,0,8"/>
     </UniformGrid>
     <TextBlock Text="{loc:Loc DirectoryAttributesHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     <Label Content="{loc:Loc DirectoryCompressionHeading}" Target="{Binding ElementName=CompressionInput}" Padding="0" Margin="0,18,0,6"/>
     <ComboBox x:Name="CompressionInput" ItemsSource="{Binding CompressionChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Compression}"/>
     <TextBlock Text="{loc:Loc DirectoryCompressionHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
     <Label Content="{loc:Loc DirectoryUninstallHeading}" Target="{Binding ElementName=UninstallInput}" Padding="0" Margin="0,18,0,6"/>
     <ComboBox x:Name="UninstallInput" ItemsSource="{Binding UninstallChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Uninstall}"/>
     <TextBlock Text="{Binding UninstallHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
     <CheckBox Content="{loc:Loc DirectoryDeleteAfterInstall}" IsChecked="{Binding DeleteAfterInstall}" Margin="0,18,0,6"/>
     <TextBlock Text="{loc:Loc DirectoryDeleteAfterInstallHint}" Style="{StaticResource MutedText}" FontSize="12"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Button Grid.Row="2" Content="{loc:Loc PageOverviewClose}" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid>
</Window>
