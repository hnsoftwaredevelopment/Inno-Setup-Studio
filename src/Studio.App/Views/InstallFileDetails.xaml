<UserControl x:Class="Studio.App.Views.InstallFileDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Studio.App">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Label Content="{loc:Loc SourceFileLabel}" Target="{Binding ElementName=SourceBox}" Padding="0" Margin="0,0,0,8" />
        <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Content="{loc:Loc ChooseSourceFile}" Click="ChooseSource_Click" IsEnabled="{Binding IsDesign}" Margin="8,0,0,0" />
            <TextBox x:Name="SourceBox" Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsPreview}"
                     MaxLength="4096" AutomationProperties.Name="{loc:Loc SourceFileLabel}" />
        </DockPanel>
        <Label Grid.Column="2" Content="{loc:Loc FileDestinationLabel}" Target="{Binding ElementName=DestinationBox}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="DestinationBox" Grid.Row="1" Grid.Column="2" Text="{Binding FileDestination, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsPreview}" MaxLength="4096" AutomationProperties.Name="{loc:Loc FileDestinationLabel}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{loc:Loc InstallFileHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{loc:Loc ExportScopeHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
    </Grid>
</UserControl>
