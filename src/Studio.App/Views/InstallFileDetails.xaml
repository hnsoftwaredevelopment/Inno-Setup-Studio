<UserControl x:Class="Studio.App.Views.InstallFileDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App">
 <StackPanel>
  <DockPanel><Button Content="{loc:Loc FilesManage}" Click="Manage_Click" IsEnabled="{Binding IsDesign}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
   <TextBlock Text="{Binding FileRuleSummary}" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBlock Text="{loc:Loc InstallFileHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
 </StackPanel>
</UserControl>
