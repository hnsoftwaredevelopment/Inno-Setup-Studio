<UserControl x:Class="Studio.App.Views.ApplicationDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Studio.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" /><ColumnDefinition Width="24" />
            <ColumnDefinition Width="3*" /><ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Label Content="{loc:Loc ProductNameLabel}" Target="{Binding ElementName=ProductNameBox}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="ProductNameBox" Grid.Row="1" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsPreview}" MaxLength="4096" AutomationProperties.Name="{loc:Loc ProductNameLabel}" />
        <Label Grid.Column="2" Content="{loc:Loc ApplicationIdLabel}" Target="{Binding ElementName=ApplicationIdBox}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="ApplicationIdBox" Grid.Row="1" Grid.Column="2" Text="{Binding ApplicationId, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsPreview}" MaxLength="127" ToolTip="{loc:Loc ApplicationIdHint}" AutomationProperties.Name="{loc:Loc ApplicationIdLabel}" />
        <Label Grid.Column="4" Content="{loc:Loc ApplicationVersionLabel}" Target="{Binding ElementName=ApplicationVersionBox}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="ApplicationVersionBox" Grid.Row="1" Grid.Column="4" Text="{Binding ApplicationVersion, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsPreview}" MaxLength="4096" AutomationProperties.Name="{loc:Loc ApplicationVersionLabel}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="{loc:Loc ApplicationDetailsHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
    </Grid>
</UserControl>
