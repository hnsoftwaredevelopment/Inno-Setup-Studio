<UserControl x:Class="Studio.App.Views.WizardPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App" xmlns:local="clr-namespace:Studio.App.Views" xmlns:core="clr-namespace:Studio.Core;assembly=Studio.Core">
    <UserControl.Resources>
        <local:SelectionOutlineConverter x:Key="SelectionOutline" />
        <Style x:Key="Element" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="Black" />
            <Setter Property="Padding" Value="6" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource SelectionOutline}">
                <Binding Path="SelectedElement" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="IsDesign" />
            </MultiBinding></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Outline" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#17685E" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outline" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource Element}">
            <Setter Property="MinWidth" Value="88" /><Setter Property="Padding" Value="3" /><Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Border BorderBrush="#ACACAC" BorderThickness="1" Background="#F5F5F5" Padding="12,5">
                    <TextBlock Text="{Binding}" Foreground="Black" TextAlignment="Center" />
                </Border>
            </DataTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Width="580" Height="430" Background="White" BorderBrush="#AEB8C0" BorderThickness="1" TextElement.FontFamily="Segoe UI" TextElement.FontSize="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="60" /></Grid.RowDefinitions>
            <Border Background="#F7F7F7" BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="12,7">
                <TextBlock Text="{Binding Project.Name, StringFormat=Installatie — {0}}" Foreground="#333333" />
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#E8EDF1" Margin="0,0,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" BorderBrush="#6B8092" BorderThickness="2" CornerRadius="8">
                            <TextBlock Text="↓" FontSize="32" Foreground="#526A7D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc WizardImage}" Foreground="#526A7D" FontSize="11" Margin="0,14,0,0" />
                        <TextBlock Text="{loc:Loc Example}" Foreground="#526A7D" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,24,20,12">
                    <StackPanel>
                        <Button Style="{StaticResource Element}" Tag="{x:Static core:ElementKind.Title}" Click="Element_Click" AutomationProperties.Name="{loc:Loc SelectTitle}">
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Button>
                        <Button Style="{StaticResource Element}" Tag="{x:Static core:ElementKind.Body}" Click="Element_Click" Margin="0,14,0,0" AutomationProperties.Name="{loc:Loc SelectBody}">
                            <TextBlock Text="{Binding PreviewBody}" TextWrapping="Wrap" LineHeight="19" />
                        </Button>
                        <StackPanel Margin="0,20,0,0" Visibility="{Binding IsDestination, Converter={StaticResource Visibility}}">
                            <TextBlock Text="Installatiemap" Margin="8,0,0,6" Foreground="#555555" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Element}" Tag="{x:Static core:ElementKind.Directory}" Click="Element_Click" HorizontalContentAlignment="Stretch"
                                        Visibility="{Binding IsDesign, Converter={StaticResource Visibility}}" AutomationProperties.Name="{loc:Loc SelectDirectory}">
                                    <Border BorderBrush="#ACACAC" BorderThickness="1" Padding="6"><TextBlock Text="{Binding DirectoryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryText}" /></Border>
                                </Button>
                                <TextBox Text="{Binding TrialDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="8" Padding="6" Visibility="{Binding IsPreview, Converter={StaticResource Visibility}}" AutomationProperties.Name="{loc:Loc TryDirectory}" />
                                <Button Grid.Column="1" Style="{StaticResource Navigation}" Tag="{x:Static core:ElementKind.Browse}" Content="{Binding BrowseCaption}" ToolTip="{Binding BrowseTooltip}" Click="Element_Click" AutomationProperties.Name="{loc:Loc ElementBrowse}" />
                            </Grid>
                            <TextBlock Text="{loc:Loc ConstantsHint}" Foreground="#666666" FontSize="10" TextWrapping="Wrap" Margin="8,6,8,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Navigation}" Tag="{x:Static core:ElementKind.Back}" Content="{Binding BackCaption}" Click="Element_Click" IsEnabled="{Binding CanGoBack}" AutomationProperties.Name="{loc:Loc ElementBack}" />
                    <Button Style="{StaticResource Navigation}" Tag="{x:Static core:ElementKind.Next}" Content="{Binding NextCaption}" Click="Element_Click" AutomationProperties.Name="{loc:Loc ElementNext}" />
                    <Button Style="{StaticResource Navigation}" Tag="{x:Static core:ElementKind.Cancel}" Content="{Binding CancelCaption}" Click="Element_Click" AutomationProperties.Name="{loc:Loc ElementCancel}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
