<Window x:Class="Studio.App.WizardTrialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{loc:Loc TrialTitle}" Icon="Resources/AppIcon.ico" Width="780" Height="820" MinWidth="650" MinHeight="600"
 WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="{loc:Loc TrialHint}" Style="{StaticResource MutedText}"/>
   <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Id"
    SelectedValue="{Binding LanguageId,Mode=OneWay}" IsEnabled="{Binding CanInteract}" SelectionChanged="Language_Changed"
    Margin="0,10,0,4" AutomationProperties.Name="{loc:Loc PreviewLanguage}"/>
   <TextBlock Text="{Binding PageName}" FontWeight="SemiBold" ToolTip="{Binding RouteHint}" Margin="0,4,0,4"/>
   <TextBlock Text="{Binding SourceHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10"/>
  </StackPanel>
  <StackPanel Grid.Row="1" IsEnabled="{Binding CanInteract}">
   <CheckBox Content="{loc:Loc CompletionPreparationProblem}" IsChecked="{Binding PreparationProblem}" Visibility="{Binding IsReady,Converter={StaticResource Visibility}}" Margin="0,0,0,10"/>
   <Button Content="{loc:Loc CompletionResolvePreparation}" Click="Resolve_Click" Visibility="{Binding IsPreparing,Converter={StaticResource Visibility}}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
   <StackPanel Visibility="{Binding IsInstalling,Converter={StaticResource Visibility}}" Margin="0,0,0,10">
    <TextBlock Text="{loc:Loc CompletionProgressHint}" Style="{StaticResource MutedText}"/>
    <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Progress}" AutomationProperties.Name="{loc:Loc CompletionProgressHint}"/>
    <Button Content="{loc:Loc CompletionComplete}" Click="Complete_Click" IsEnabled="{Binding CanComplete}" HorizontalAlignment="Left"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
   <Border Width="600" Height="480" Background="White" BorderBrush="#AEB8C0" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
     <Border Background="#F7F7F7" BorderBrush="#DADADA" BorderThickness="0,0,0,1" Padding="12,7"><TextBlock Text="{Binding WindowTitle}"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24">
      <StackPanel><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,14,0,12"/>
       <StackPanel Visibility="{Binding IsDocument,Converter={StaticResource Visibility}}">
        <TextBlock x:Name="DocumentStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
        <RichTextBox x:Name="DocumentPreview" IsReadOnly="True" Height="150" VerticalScrollBarVisibility="Auto" IsDocumentEnabled="False"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsLicense,Converter={StaticResource Visibility}}" Margin="0,8,0,0">
        <RadioButton Content="{Binding LicenseAcceptCaption}" GroupName="License" IsChecked="{Binding LicenseAccepted}" IsEnabled="{Binding DocumentAvailable}" Margin="0,0,0,5"/>
        <RadioButton Content="{Binding LicenseDeclineCaption}" GroupName="License" IsChecked="{Binding LicenseDeclined}"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsUserInfo,Converter={StaticResource Visibility}}">
        <Label Content="{Binding UserNameCaption}" Target="{Binding ElementName=UserNameInput}" Padding="0"/>
        <TextBox x:Name="UserNameInput" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
        <Label Content="{Binding OrganizationCaption}" Target="{Binding ElementName=OrganizationInput}" Padding="0"/>
        <TextBox x:Name="OrganizationInput" Text="{Binding Organization,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
        <TextBlock Text="{loc:Loc TrialExpressions}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel Visibility="{Binding IsDestination,Converter={StaticResource Visibility}}">
        <DockPanel><Button Content="{Binding BrowseCaption}" ToolTip="{Binding BrowseTooltip}" DockPanel.Dock="Right" Click="Browse_Click" Margin="8,0,0,0"/>
         <TextBox x:Name="DirectoryInput" Text="{Binding Directory,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc DefaultDirectoryLabel}"/>
        </DockPanel>
        <TextBlock Text="{loc:Loc TrialExpressions}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
       </StackPanel>
       <TextBox Text="{Binding Summary,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="170" Margin="0,10,0,0" Visibility="{Binding IsReady,Converter={StaticResource Visibility}}"/>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="20" Margin="0,20,0,0" Visibility="{Binding IsInstalling,Converter={StaticResource Visibility}}"/>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#D5D5D5" BorderThickness="0,1,0,0" Padding="10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanInteract}">
       <Button Content="{Binding BackCaption}" Click="Back_Click" IsEnabled="{Binding CanBack}" Visibility="{Binding ShowBack,Converter={StaticResource Visibility}}" Margin="0,0,8,0"/>
       <Button Content="{Binding NextCaption}" Click="Next_Click" IsEnabled="{Binding CanNext}" Visibility="{Binding ShowNext,Converter={StaticResource Visibility}}" Margin="0,0,8,0"/>
       <Button Content="{Binding CancelCaption}" Click="Cancel_Click" Visibility="{Binding ShowCancel,Converter={StaticResource Visibility}}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </ScrollViewer>
  <Button Grid.Row="3" Content="{loc:Loc CompletionClose}" Click="Close_Click" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0"/>
 </Grid>
</Window>
