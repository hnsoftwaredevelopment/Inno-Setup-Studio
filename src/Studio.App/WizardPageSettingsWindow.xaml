<Window x:Class="Studio.App.WizardPageSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{Binding Title}" Icon="Resources/AppIcon.ico" Width="620" Height="670" MinWidth="470" MinHeight="470" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <StackPanel Visibility="{Binding IsUserInfo,Converter={StaticResource Visibility}}">
    <CheckBox Content="{loc:Loc UserInfoEnabled}" IsChecked="{Binding UserInfoEnabled}" Margin="0,0,0,12"/>
    <StackPanel IsEnabled="{Binding UserInfoEnabled}">
     <TextBlock Text="{loc:Loc UserInfoDefaultName}" Margin="0,0,0,6"/>
     <TextBox Text="{Binding DefaultName,UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Text="{loc:Loc UserInfoDefaultOrganization}" Margin="0,12,0,6"/>
     <TextBox Text="{Binding DefaultOrganization,UpdateSourceTrigger=PropertyChanged}"/>
     <CheckBox Content="{loc:Loc UserInfoPrevious}" IsChecked="{Binding UsePreviousUserInfo}" Margin="0,12,0,0"/>
    </StackPanel>
    <TextBlock Text="{loc:Loc UserInfoHint}" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
   </StackPanel>
   <StackPanel Visibility="{Binding IsProgramGroup,Converter={StaticResource Visibility}}">
    <TextBlock Text="{loc:Loc GroupPolicy}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding GroupModes}" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectedValue="{Binding GroupMode}"/>
    <TextBlock Text="{loc:Loc GroupDefaultName}" Margin="0,12,0,6"/>
    <TextBox Text="{Binding DefaultGroup,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="{loc:Loc GroupDefaultHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
    <CheckBox Content="{loc:Loc GroupAllowNoIcons}" IsChecked="{Binding AllowNoIcons}" Margin="0,12,0,0"/>
    <CheckBox Content="{loc:Loc GroupPrevious}" IsChecked="{Binding UsePreviousGroup}" Margin="0,12,0,0"/>
    <TextBlock Text="{Binding GroupAvailabilityHint}" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
   </StackPanel>
   <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
    <StackPanel>
     <TextBlock Text="{loc:Loc PageInputPreview}" FontWeight="SemiBold"/>
     <TextBlock Text="{loc:Loc PageInputPreviewHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,12"/>
     <StackPanel Visibility="{Binding IsUserInfo,Converter={StaticResource Visibility}}" IsEnabled="{Binding UserInfoEnabled}">
      <TextBlock Text="{loc:Loc UserInfoDefaultName}" Margin="0,0,0,6"/><TextBox Text="{Binding TrialName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{loc:Loc UserInfoDefaultOrganization}" Margin="0,12,0,6"/><TextBox Text="{Binding TrialOrganization,UpdateSourceTrigger=PropertyChanged}"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsProgramGroup,Converter={StaticResource Visibility}}">
      <TextBlock Text="{loc:Loc GroupDefaultName}" Margin="0,0,0,6"/><TextBox Text="{Binding TrialGroup,UpdateSourceTrigger=PropertyChanged}"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </StackPanel></ScrollViewer>
  <Button Grid.Row="1" Content="{loc:Loc PageOverviewClose}" Click="Close_Click" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid>
</Window>
