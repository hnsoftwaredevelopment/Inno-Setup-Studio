<Window x:Class="Studio.App.ProjectLanguagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Studio.App"
        Title="{loc:Loc ProjectLanguages}" Icon="Resources/AppIcon.ico" Width="700" Height="490"
        MinWidth="560" MinHeight="390" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc ProjectLanguagesHint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ListBox x:Name="Languages" Grid.Row="1" AutomationProperties.Name="{loc:Loc ProjectLanguages}">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Enabled_Click"/>
                <TextBlock Text="{Binding Source}" Foreground="Gray" TextWrapping="Wrap" Margin="20,4,0,0"/>
                <TextBlock Text="{Binding TextOrigin}" Foreground="Gray" Margin="20,4,0,0"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{loc:Loc AddProjectLanguage}" Click="Add_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc LanguageUp}" Click="Up_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc LanguageDown}" Click="Down_Click"/>
            <Button Content="{loc:Loc RemoveProjectLanguage}" Click="Remove_Click" Margin="8,0,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
