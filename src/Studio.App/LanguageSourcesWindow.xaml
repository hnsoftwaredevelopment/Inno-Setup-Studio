<Window x:Class="Studio.App.LanguageSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Studio.App"
        Title="{loc:Loc LanguageSources}" Width="1100" Height="700" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
        <StackPanel x:Name="Actions" Orientation="Horizontal">
            <Button Content="{loc:Loc AddLanguageSource}" Click="Add_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Loc ReloadLanguageSources}" Click="Reload_Click" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{loc:Loc LanguageSourcesScope}" TextWrapping="Wrap" Margin="0,12,0,12" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Sources" SelectionChanged="Selection_Changed" AutomationProperties.Name="{loc:Loc LanguageSources}">
                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NativeName}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="SourcePath" IsReadOnly="True" AutomationProperties.Name="{loc:Loc LanguageSourcePath}" />
                <TextBlock x:Name="SourceDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,8" />
                <DataGrid x:Name="Entries" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"
                          AutomationProperties.Name="{loc:Loc LanguageSourceEntries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc LanguageSourceSection}" Binding="{Binding Section}" Width="110" />
                        <DataGridTextColumn Header="{loc:Loc LanguageSourceKey}" Binding="{Binding Key}" Width="180" />
                        <DataGridTextColumn Header="{loc:Loc LanguageSourceValue}" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <TextBox x:Name="Problems" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                 AutomationProperties.Name="{loc:Loc LanguageSourceProblems}" />
    </Grid>
</Window>
