<Window x:Class="Studio.App.InstallTypesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{loc:Loc InstallTypesHeading}" Icon="Resources/AppIcon.ico" Width="940" Height="720" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Loc InstallTypesHeading}" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="{loc:Loc InstallTypesHint}" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
   <TextBlock Text="{loc:Loc InstallTypesStageHint}" Style="{StaticResource MutedText}"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Top">
    <WrapPanel Margin="0,0,0,8"><Button Content="{loc:Loc FilesAdd}" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0"/><Button Content="{loc:Loc FilesRemove}" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/></WrapPanel>
    <WrapPanel Margin="0,0,0,10"><Button Content="{loc:Loc LanguageUp}" Click="Up_Click" IsEnabled="{Binding CanMoveUp}" Margin="0,0,8,0"/><Button Content="{loc:Loc LanguageDown}" Click="Down_Click" IsEnabled="{Binding CanMoveDown}"/></WrapPanel>
   </StackPanel><ListBox x:Name="TypeList" ItemsSource="{Binding Types}" SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc InstallTypesHeading}"/></DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
    <StackPanel IsEnabled="{Binding HasSelection}">
     <Label Content="{loc:Loc InstallTypeDescription}" Target="{Binding ElementName=DescriptionInput}" Padding="0"/><TextBox x:Name="DescriptionInput" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" Margin="0,6,0,6"/>
     <TextBlock Text="{loc:Loc InstallTypeDescriptionHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     <Expander Header="{loc:Loc InstallTypeTranslations}" IsExpanded="True" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0">
      <TextBlock Text="{loc:Loc InstallTypeTranslationHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10"/>
      <Label Content="{loc:Loc InstallTypeLanguage}" Target="{Binding ElementName=LanguageInput}" Padding="0"/>
      <ComboBox x:Name="LanguageInput" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LanguageId}" Margin="0,6,0,12"/>
      <Label Content="{loc:Loc OwnTranslationText}" Target="{Binding ElementName=TranslationInput}" Padding="0"/>
      <Grid Margin="0,6,0,6"><TextBox x:Name="TranslationInput" Text="{Binding Translation,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
       <TextBlock Text="{Binding EffectiveDescription}" Foreground="{StaticResource Muted}" Margin="11,9" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Translation}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
     </StackPanel></Expander>
     <Label Content="{loc:Loc InstallTypeName}" Target="{Binding ElementName=NameInput}" Padding="0" Margin="0,14,0,6"/><TextBox x:Name="NameInput" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="128"/>
     <TextBlock Text="{loc:Loc InstallTypeNameHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
     <CheckBox Content="{loc:Loc InstallTypeCustom}" IsChecked="{Binding IsCustom}" Margin="0,16,0,6"/>
     <TextBlock Text="{loc:Loc InstallTypeCustomHint}" Style="{StaticResource MutedText}" FontSize="12"/>

    </StackPanel>
    <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <Button Grid.Row="2" Content="{loc:Loc PageOverviewClose}" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid>
</Window>
