<Window x:Class="Studio.App.ShortcutRulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{loc:Loc ShortcutsHeading}" Icon="Resources/AppIcon.ico" Width="940" Height="740" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Loc ShortcutsHeading}" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="{loc:Loc ShortcutsHint}" Style="{StaticResource MutedText}" Margin="0,6,0,8"/>
   <DockPanel><Button Content="{loc:Loc ShortcutRefresh}" Click="Refresh_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock Text="{Binding ReferenceStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></DockPanel>
   <TextBlock Text="{Binding ReferenceError}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <Button Content="{loc:Loc FilesAdd}" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0"/><Button Content="{loc:Loc FilesRemove}" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/>
   </WrapPanel><ListBox ItemsSource="{Binding Rules}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc ShortcutsHeading}"/></DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
    <StackPanel IsEnabled="{Binding HasSelection}">
     <Label Content="{loc:Loc ShortcutName}" Target="{Binding ElementName=NameInput}" Padding="0"/><TextBox x:Name="NameInput" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" Margin="0,6,0,6"/>
     <TextBlock Text="{loc:Loc ShortcutNameHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     <Label Content="{loc:Loc ShortcutFolderLabel}" Target="{Binding ElementName=FolderInput}" Padding="0" Margin="0,14,0,6"/><ComboBox x:Name="FolderInput" ItemsSource="{Binding Folders}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Folder}"/>
     <Label Content="{loc:Loc ShortcutTarget}" Target="{Binding ElementName=TargetInput}" Padding="0" Margin="0,14,0,6"/>
     <ComboBox x:Name="TargetInput" IsTextSearchEnabled="True" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget,Mode=TwoWay}"/>
     <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <TextBlock Text="{loc:Loc ShortcutTargetHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
     <Expander Header="{loc:Loc ShortcutExtraOptions}" Margin="0,18,0,0"><StackPanel Margin="0,8,0,0">
     <Label Content="{loc:Loc ShortcutSubfolder}" Target="{Binding ElementName=SubfolderInput}" Padding="0" Margin="0,14,0,6"/><TextBox x:Name="SubfolderInput" Text="{Binding Subfolder,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
     <Label Content="{loc:Loc ShortcutParameters}" Target="{Binding ElementName=ParametersInput}" Padding="0" Margin="0,14,0,6"/><TextBox x:Name="ParametersInput" Text="{Binding Parameters,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
     <Label Content="{loc:Loc ShortcutWorkingDirectory}" Target="{Binding ElementName=WorkingDirectoryInput}" Padding="0" Margin="0,14,0,6"/><TextBox x:Name="WorkingDirectoryInput" Text="{Binding WorkingDirectory,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
     <Label Content="{loc:Loc ShortcutTargetPath}" Target="{Binding ElementName=TargetPathInput}" Padding="0" Margin="0,14,0,6"/><TextBox x:Name="TargetPathInput" Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096"/>
     </StackPanel></Expander>
    </StackPanel>
    <Border x:Name="StartMenuSettings" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStartMenu}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
     <TextBlock Text="{Binding GroupHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     <Button Content="{loc:Loc ShortcutGroupSettings}" Click="Group_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <TextBlock x:Name="DesktopOptionsHint" Text="{loc:Loc ShortcutDesktopTaskHint}" Margin="0,18,0,0" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDesktop}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </StackPanel></ScrollViewer>
  </Grid>
  <Button Grid.Row="2" Content="{loc:Loc PageOverviewClose}" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid>
</Window>
