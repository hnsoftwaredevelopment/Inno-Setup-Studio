<Window x:Class="Studio.App.FileRulesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Studio.App"
 Title="{loc:Loc FilesHeading}" Icon="Resources/AppIcon.ico" Width="1040" Height="790" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Loc FilesHeading}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc FilesHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
    <Button Content="{loc:Loc FilesAdd}" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0"/>
    <Button Content="{loc:Loc FilesRemove}" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/>
   </WrapPanel>
   <ListBox ItemsSource="{Binding Rules}" SelectedIndex="{Binding SelectedIndex}" DisplayMemberPath="Name" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc FilesHeading}"/>
   </DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <Label Content="{loc:Loc FilesSource}" Target="{Binding ElementName=SourceInput}" Padding="0"/>
     <TextBox x:Name="SourceInput" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" Margin="0,6,0,8"/>
     <WrapPanel><Button Content="{loc:Loc ChooseSourceFile}" Click="ChooseFile_Click" Margin="0,0,8,0"/><Button Content="{loc:Loc FilesChooseFolder}" Click="ChooseFolder_Click"/></WrapPanel>
     <Label Content="{loc:Loc FileDestinationLabel}" Target="{Binding ElementName=DestinationInput}" Padding="0" Margin="0,14,0,0"/>
     <TextBox x:Name="DestinationInput" Text="{Binding Destination,UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" Margin="0,6,0,8"/>
     <CheckBox Content="{loc:Loc FilesRecurse}" IsChecked="{Binding RecurseSubdirectories}"/>
     <Label Content="{loc:Loc FilesExcludes}" Target="{Binding ElementName=ExcludesInput}" Padding="0" Margin="0,14,0,0"/>
     <TextBox x:Name="ExcludesInput" Text="{Binding Excludes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
     <TextBlock Text="{loc:Loc FilesExcludesHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,14,0,8">
     <Button Content="{loc:Loc FilesRefresh}" Click="Refresh_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="PreviewStatus" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0"/>
     <TextBlock x:Name="PreviewError" Foreground="#B42318" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <DataGrid x:Name="FilePreview" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="{loc:Loc FilesRefresh}">
     <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc FilesSource}" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="{loc:Loc FileDestinationLabel}" Binding="{Binding Destination}" Width="*"/></DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Grid>
  <Button Grid.Row="2" Content="{loc:Loc PageOverviewClose}" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="0,14,0,0"/>
 </Grid>
</Window>
